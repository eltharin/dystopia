<section>
    
    <div class="field">
        <label>{{localizeSystem "sheet.items.competence.zoneAction.titre"}}</label>
        <div>{{#fieldOrInput "system.zoneAction" class="pj-sheet-input" }}
            <select name="system.zoneAction">
                {{ log ../listZoneAction }}
                {{selectOptions ../listZoneAction selected=../system.zoneAction localize=true}}
            </select>
            {{/fieldOrInput}}
        </div>
    </div>

<div class="flexcols">
    <div class="field">
        <label>{{localizeSystem "sheet.items.arme.coutUtilisationPE"}}</label>
        <div>{{ fieldOrInput "system.coutUtilisation.pe" class="pj-sheet-input" }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.items.arme.coutUtilisationPM"}}</label>
        <div>{{ fieldOrInput "system.coutUtilisation.pm" class="pj-sheet-input" }}</div>
    </div>
</div>

<div class="flexcols">
    <div class="field">
        <label>{{localizeSystem "sheet.items.arme.degats.physique"}}</label>
        <div>{{ fieldOrInput "system.degats.physique" class="pj-sheet-input" }}</div>
    </div>
    
    <div class="field">
        <label>{{localizeSystem "sheet.items.arme.degats.magique"}}</label>
        <div>{{ fieldOrInput "system.degats.magique" class="pj-sheet-input" }}</div>
    </div>
</div>       

</section>