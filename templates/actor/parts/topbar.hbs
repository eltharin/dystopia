
<div class="perso flexcols">
    <div class="field pv">
        <label>{{localizeSystem "sheet.actor.carac.pv"}}</label>
        <div class="valeur">
            <div>
                <span class="total">{{system.values.pv.total}}</span>
                <span class="calc">({{ fieldOrInput "system.values.pv.val" class="pj-sheet-input" }} + {{ system.values.pv.temp }})</span>
            </div>
            <div>
                <span class="total">{{system.values.pv.totalMax}}</span>
                <span class="calc">({{ fieldOrInput "system.values.pv.max" class="pj-sheet-input" }} + {{ system.values.pv.tempMax }})</span>
            </div>
        </div>
    </div>


