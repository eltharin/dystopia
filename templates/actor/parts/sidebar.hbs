<div class="image">
    <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
</div>

<div class="sidebar_content">
    <div>
        <div class="button" data-action="globalRoll">Lancer les dés</div>
    </div>


    <div class="flexcols">
        <div class="field">
            <label>{{localizeSystem "sheet.actor.seuilDefense"}}</label>
            <div>{{ fieldOrInput "system.values.seuilDefense.val" class="pj-sheet-input" }}</div>
        </div>
    </div>

    <div class="flexcols">
        <div class="field">
            <label>{{localizeSystem "sheet.actor.seuilCritique.titre"}}</label>
            <div>{{ fieldOrInput "system.values.seuilCritique.val" class="pj-sheet-input" }}</div>
        </div>
        <div>(+ {{system.values.seuilCritique.temp}}) => {{system.values.seuilCritique.total}}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.carac.pv"}}</label>
        <div>{{ fieldOrInput "system.values.pv.val" class="pj-sheet-input" }} ({{ fieldOrInput "system.values.pv.temp" class="pj-sheet-input" }}) => {{system.values.pv.total}}</div>
        <div>{{ fieldOrInput "system.values.pv.max" class="pj-sheet-input" }} ({{ fieldOrInput "system.values.pv.tempMax" class="pj-sheet-input" }}) => {{system.values.pv.totalMax}}</div>
    </div>

    <div class="flexcols">
        <div class="field">
            <label>{{localizeSystem "sheet.actor.coutDeplacement"}} (PE/m)</label>
            <div>{{ fieldOrInput "system.values.coutDeplacement.val" class="pj-sheet-input" }}</div>
        </div>
        <div> / {{system.values.coutDeplacement.temp}} / {{coutDeplacementBonus}} / {{system.values.coutDeplacement.total}}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.carac.pe"}}</label>
        <div>{{ fieldOrInput "system.values.pe.val" class="pj-sheet-input" }} / {{ fieldOrInput "system.values.pe.max" class="pj-sheet-input" }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.carac.pm"}}</label>
        <div>{{ fieldOrInput "system.values.pm.val" class="pj-sheet-input" }} / {{ fieldOrInput "system.values.pm.max" class="pj-sheet-input" }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.carac.sm"}}</label>
        <div>{{ fieldOrInput "system.values.sm.val" class="pj-sheet-input" }} / {{ fieldOrInput "system.values.sm.max" class="pj-sheet-input" }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.carac.volonte"}}</label>
        <div>{{ fieldOrInput "system.values.volonte.val" class="pj-sheet-input" }} / {{ fieldOrInput "system.values.volonte.max" class="pj-sheet-input" }}</div>
    </div>


    <div class="field">
        <label>malus armure</label>
        <div>{{system.malus.armure.physique}}</div>
        <div>{{system.malus.armure.magique}}</div>
    </div>
</div>

