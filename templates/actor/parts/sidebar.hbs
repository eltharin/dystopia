<div class="image">
    <img data-action="editImage" data-edit="img" src="{{document.img}}" alt="Photo de {{document.name}}" />
</div>

<div class="sidebar_content">
    <div class="field nom">
        <label>{{localize (concat (SYSTEMID) ".sheet.common.nom")}}</label>
        <div>{{ fieldOrInput "name" class="pj-sheet-input" value=document.name}}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.niveau"}}</label>
        <div>{{ fieldOrInput "system.niveau" class="pj-sheet-input" }}</div>
    </div>
    
    
    <div class="lancerDe">
        <div class="button" data-action="globalRoll">Lancer les dés</div>
    </div>


    <div class="field">
        <label>{{localizeSystem "sheet.actor.seuilDefense"}}</label>
        <div class="total-result">
            <span class="total">{{system.values.seuilDefense.total}}</span>
            <span class="input">{{ fieldOrInput "system.values.seuilDefense.val" class="pj-sheet-input" }}</span>
            <span class="calc">(+ {{system.values.seuilDefense.temp}})</span>
        </div>
    </div>
    
    <div class="field">
        <label>{{localizeSystem "sheet.actor.seuilCritique.titre"}}</label>
        <div class="total-result">
            <span class="total">{{system.values.seuilCritique.total}}</span>
            <span class="input">{{ fieldOrInput "system.values.seuilCritique.val" class="pj-sheet-input" }}</span>
            <span class="calc">(+ {{system.values.seuilCritique.temp}})</span>
        </div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.coutDeplacement"}} (PE/m)</label>
        <div class="total-result">
            <span class="total">{{system.values.coutDeplacement.total}}</span>
            <span class="input">{{ fieldOrInput "system.values.coutDeplacement.val" class="pj-sheet-input" }}</span>
            <span class="calc">(+ {{system.values.coutDeplacement.temp}} + {{coutDeplacementBonus}})</span>
        </div>
    </div>




    <div class="field">
        <label>malus armure</label>
        <div>physique : {{system.malus.armure.physique}}</div>
        <div>magique : {{system.malus.armure.magique}}</div>
    </div>
</div>

