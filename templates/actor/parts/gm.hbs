<div>
    <div class="field">
        <label>{{localizeSystem "sheet.actor.seuilCritique.temp"}}</label>
        <div>{{ system.seuilCritique.temp }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.reaction.temp"}}</label>
        <div>{{ system.values.reaction.val }} + {{ system.values.reaction.temp }} = {{ system.values.reaction.total }}</div>
        <div>{{ system.values.coutUtilReaction.val }} + {{ system.values.coutUtilReaction.temp }} = {{ system.values.coutUtilReaction.total }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.coutPeEsquive"}}</label>
        <div>{{ fieldOrInput "system.values.coutPeEsquive.val" class="pj-sheet-input" }} + {{ system.values.coutPeEsquive.temp }}</div>
    </div>

    <div class="field">
        <label>{{localizeSystem "sheet.actor.initiative"}}</label>
        <div>{{ fieldOrInput "system.initiative" class="pj-sheet-input" }}</div>
    </div>

    <h2>{{localizeSystem "sheet.actor.traumas.titre"}}</h2>
    <div class="field">
        <label>{{localizeSystem "sheet.actor.traumas.nbNiveaux"}}</label>
        <div>{{ fieldOrInput "system.traumas.nbNiveaux" class="pj-sheet-input" }}</div>
    </div>

    <div>
        <label>{{localizeSystem "sheet.actor.traumas.nbTraumas"}}</label>
        <div class="flexrow">
        {{#times system.traumas.nbNiveaux}}
            <div class="field">
                <label>{{localizeSystem "sheet.actor.traumas.titreNiveau" key=index1}}</label>
                <div>{{ fieldOrInput (concat "system.traumas.niveaux." index ".nbTraumas") class="pj-sheet-input" }}</div>
            </div>
        {{/times}}
        </div>
    </div>
</div>