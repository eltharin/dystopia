<div class="attaque_message">
    <span class="flavor-text" style="">{{localizeSystem "combat.attaque.label" actor=actor}}</span>
    <div class="dice-formula">
        <ul class="cibles">
            {{#each cibles as |cible|}}
                <li><span class="nom">{{cible.name}}</span>
                    {{#if cible.result}}
                        <span class="action">{{cible.result}}</span>
                    {{else}}
                        {{#if cible.canUpdate}}
                            <span class="action button" data-action="reponseAttaque" data-foractoruuid="{{cible.uuid}}">{{localizeSystem "combat.attaque.repondreBtn" }}</span>
                        {{/if}}
                    {{/if}}
                </li>
            {{/each}}
        </ul>
    </div>

    {{valeur}}
    {{#if canLaunch}}
    <div class="button attaque_btn" data-action="deAttaque">{{localizeSystem "combat.attaque.attaqueBtn" }}</div>
    {{/if}}
</div>