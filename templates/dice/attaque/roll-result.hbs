<div class="result_attaque_message" >
    
    <div class="result_infos section">
        <div><span class="title">seuil Crit : </span>{{actor.seuilCritique}}</div>
        <div><span class="title">Bonus Dégats : </span>{{actor.bonusDegats}}</div>
        <div><span class="title">Degats physiques : </span>{{item.system.degats.physique}}</div>
        <div><span class="title">Degats magiques : </span>{{item.system.degats.magique}}</div>
    </div>
    <div class="dice-roll" data-action="expandRoll">
        
        <div  class="dice-result" >
        {{{tooltip}}}
        </div>
        <div class="dice-formula">{{localize (concat (SYSTEMID) ".roll.common.total")}} : {{total}}</div>
    </div>
        
        {{#each cibles as |cible|}}
        <div class="cible_result section">
            <h4 class="dice-total">{{cible.name}}</h4>
            {{#if cible.critique}}<div class="message">Coup Critique</div>{{/if}}
            <div><span class="title">seuil Défense : </span>{{cible.seuil}}</div>
            <div><span class="title">armure physique : </span>{{cible.armure.physique}}</div>
            <div><span class="title">armure magique : </span>{{cible.armure.magique}}</div>
            <div><span class="title">armure mixte : </span>{{cible.armure.mixte}}</div>
            <div><span class="title">malus armure : </span>{{cible.armure.malusPhysique}}/{{cible.armure.malusMagique}}</div>
    
            <div class="message">total PV : {{cible.degats}}</div>
            <div class="button attaque_btn"  data-action="enleverPV" data-token="{{cible.uuid}}" data-nbPv="{{cible.degats}}">{{localize (concat (SYSTEMID) ".combat.attaque.supprPV")}}</div>
        </div>
        {{/each}}
        
    
</div>
